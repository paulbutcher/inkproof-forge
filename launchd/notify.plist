<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Installed by scripts/notify-install.sh, which fills in the paths. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>@LABEL@</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>@KIT@/scripts/notify.sh</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict><key>PATH</key><string>@PATH@</string></dict>
  <key>StartInterval</key><integer>60</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>@KIT@/control/notify.log</string>
  <key>StandardErrorPath</key><string>@KIT@/control/notify.log</string>
</dict>
</plist>
