<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Installed by scripts/backup-install.sh, which fills in the paths. Runs
     scripts/backup.sh daily at 03:30, or when the Mac next wakes if it was
     asleep then, and shows a notification if it fails. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>@LABEL@</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-c</string>
    <string>date; "@KIT@/scripts/backup.sh" || osascript -e 'display notification "The daily backup failed: see @LOG@" with title "Inkproof forge"'</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict><key>PATH</key><string>@PATH@</string></dict>
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>3</integer><key>Minute</key><integer>30</integer></dict>
  <key>StandardOutPath</key><string>@LOG@</string>
  <key>StandardErrorPath</key><string>@LOG@</string>
</dict>
</plist>
