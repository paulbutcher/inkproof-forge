#!/usr/bin/env python3
"""forge: the Forgejo operations agents need that tea lacks, or that must
follow a rule tea can't enforce. Uses the agent's own token.

  forge pr automerge <n>          merge your pull request #n now if nothing
                                  stands in its way, else schedule "merge when
                                  checks succeed": it waits for the approvals
                                  your repository's autonomy level requires
  forge pr merge <n>              merge your pull request #n now, or say why
                                  Forgejo won't: for a scheduled merge that
                                  hasn't gone through
  forge ci <repo> <pr|main>       the Actions run for the pull request's head
                                  commit (or main's): success, failure, running
                                  or none
  forge ci <repo> <pr|main> --log [all]
                                  the log of each failed job in that run (each
                                  job's, if none failed): its last 200 lines,
                                  or all of them
  forge ci <repo> <pr|main> --rerun
                                  run that run again, if it failed, in your own
                                  repository: only when its log shows the
                                  failure is the runner's (a package download,
                                  a crashed job), not the code's
  forge pr approve <repo> <n> <message>
                                  (coordinator) approve, only if the Actions run
                                  for the head commit succeeded
  forge review <repo> <n> <findings.json>
                                  (conformance) review the pull request's head:
                                  approves if no finding is open (new, kept or
                                  agreed), requests changes otherwise, and after
                                  the rounds limit puts the findings the author
                                  disputes (kept) to the human instead, once per
                                  head. The file is
                                  {"summary": "...", "findings": [{"section":
                                  "<CLAUDE.md or protocol section>", "finding":
                                  "...", "status":
                                  "new|kept|agreed|fixed|withdrawn"}]}
  forge reviews <repo> <n>        the pull request's reviews: who, verdict,
                                  commit and text, oldest first
  forge ledger [days]             (process) the run ledger for the last days
                                  (default 30): runs, the human's sessions,
                                  notices, as JSON
  forge release <repo> <note> [<issue>...]
                                  (coordinator, level 3) ask the gatekeeper to
                                  release <repo>: it computes the version from
                                  API.lock since the last tag, checks
                                  CHANGELOG.md has its entry and CI passed on
                                  main, tags main and publishes the release, and
                                  comments on each ready-for-release issue

<repo> is a repository name such as inkproof-core; pull requests are numbers.
"""
import json
import os
import re
import sys
import time
import urllib.error
import urllib.request

FORGE = "http://forgejo:3000/api/v1"
ORG = os.environ.get("FORGE_ORG", "")
OWN = os.environ.get("AGENT_REPO", "")
ME = os.environ.get("AGENT_NAME", "")


def die(msg, code=1):
    print(f"forge: {msg}", file=sys.stderr)
    sys.exit(code)


def usage():
    print(__doc__.strip(), file=sys.stderr)
    sys.exit(2)


def api(method, path, body=None):
    with open("/run/secrets/forgejo_token") as f:
        token = f.read().strip()
    data = json.dumps(body).encode() if body is not None else None
    req = urllib.request.Request(FORGE + path, data=data, method=method, headers={
        "Authorization": f"token {token}", "Accept": "application/json",
        **({"Content-Type": "application/json"} if data else {})})
    try:
        with urllib.request.urlopen(req, timeout=60) as r:
            raw = r.read()
            return r.status, (json.loads(raw) if raw.strip() else None)
    except urllib.error.HTTPError as e:
        raw = e.read()
        try:
            return e.code, json.loads(raw)
        except Exception:
            return e.code, {"message": raw.decode(errors="replace")[:500]}


def api_text(method, path):
    """A GET whose answer is plain text, such as a job's log."""
    with open("/run/secrets/forgejo_token") as f:
        token = f.read().strip()
    req = urllib.request.Request(FORGE + path, method=method, headers={"Authorization": f"token {token}"})
    try:
        with urllib.request.urlopen(req, timeout=60) as r:
            return r.status, r.read().decode(errors="replace")
    except urllib.error.HTTPError as e:
        return e.code, e.read().decode(errors="replace")[:500]


def merge_call(n, body):
    """Ask Forgejo to merge #n. For a few seconds after a pull request is
    opened or pushed to, Forgejo is still checking that it merges cleanly
    and answers every merge, scheduled or not, with 405 "try again later":
    wait that out, for about a minute at most."""
    for wait in (2, 4, 8, 15, 30, 0):
        s, p = api("POST", f"/repos/{ORG}/{OWN}/pulls/{n}/merge", body)
        if not (s == 405 and "try again later" in ((p or {}).get("message") or "").lower()) or not wait:
            return s, p
        time.sleep(wait)


def number(s):
    if not s.isdigit():
        die(f"{s!r} isn't a pull request number")
    return int(s)


def repo_name(s):
    """A repository in the organisation; the account's permissions decide the rest."""
    s = s.split("/")[-1]
    if not s or not all(c.isalnum() or c in "-_." for c in s):
        die(f"{s!r} isn't a repository name")
    return s


def head_of(repo, pr):
    """The commit CI runs on: a pull request's head, or main's."""
    if pr == "main":
        s, b = api("GET", f"/repos/{ORG}/{repo}/branches/main")
        if s != 200:
            die(f"can't read {repo}'s main: {(b or {}).get('message', s)}")
        return b["commit"]["id"]
    s, p = api("GET", f"/repos/{ORG}/{repo}/pulls/{pr}")
    if s != 200:
        die(f"can't read {repo}#{pr}: {p.get('message', s)}")
    return p["head"]["sha"]


def runs_for(repo, sha):
    """The Actions runs for a commit, newest first."""
    s, runs = api("GET", f"/repos/{ORG}/{repo}/actions/runs?head_sha={sha}")
    if s != 200:
        die(f"can't read {repo}'s Actions runs: {(runs or {}).get('message', s)}")
    runs = runs.get("workflow_runs", runs) if isinstance(runs, dict) else runs
    mine = [r for r in runs or [] if (r.get("commit_sha") or r.get("head_sha")) == sha]
    return sorted(mine, key=lambda r: r.get("id", 0), reverse=True)


LOG_LINES = 200
STAMP = re.compile(r"^\d{4}-\d\d-\d\dT[\d:.]+Z ")


def ci_logs(repo, sha, everything):
    """Print the log of each failed job of the newest run for sha (each job's,
    if none failed): the last LOG_LINES lines, or all of them."""
    runs = runs_for(repo, sha)
    if not runs:
        die(f"no Actions run for {sha[:12]} in {repo}")
    run = runs[0]
    s, jobs = api("GET", f"/repos/{ORG}/{repo}/actions/runs/{run['id']}/jobs")
    if s != 200:
        die(f"can't read run {run['id']}'s jobs: {(jobs or {}).get('message', s)}")
    jobs = jobs.get("jobs", jobs) if isinstance(jobs, dict) else jobs or []
    shown = [j for j in jobs if j.get("status") == "failure"] or jobs
    for j in shown:
        s, log = api_text("GET", f"/repos/{ORG}/{repo}/actions/jobs/{j['id']}/logs")
        if s != 200:
            die(f"can't read job {j.get('name')}'s log ({s})")
        lines = [STAMP.sub("", l) for l in log.splitlines()]
        print(f"=== {repo} run {run.get('index_in_repo', run['id'])}, job {j.get('name')}: {j.get('status')} "
              f"({sha[:12]})")
        if not everything and len(lines) > LOG_LINES:
            print(f"(the first {len(lines) - LOG_LINES} lines are left out; --log all shows them)")
            lines = lines[-LOG_LINES:]
        print("\n".join(lines))


def ci_rerun(repo, target):
    """Run the newest failed Actions run for the head again, in your own
    repository: for a failure that is the runner's, not the code's."""
    sha = head_of(repo, target)
    runs = runs_for(repo, sha)
    if not runs:
        die(f"no Actions run for {sha[:12]} in {repo}")
    run = runs[0]
    if run.get("status") not in ("failure", "cancelled"):
        die(f"run {run.get('index_in_repo', run['id'])} for {sha[:12]} is {run.get('status')}: only a failed run "
            "is run again")
    s, p = api("POST", f"/repos/{ORG}/{repo}/actions/runs/{run['id']}/rerun")
    if s // 100 != 2:
        die(f"couldn't run {repo}'s run {run.get('index_in_repo', run['id'])} again ({s}): "
            f"{(p or {}).get('message', '')}")
    print(f"Running {repo}'s run {run.get('index_in_repo', run['id'])} for {sha[:12]} again.")


def ci_state(repo, pr):
    sha = head_of(repo, pr)
    mine = runs_for(repo, sha)
    if not mine:
        return sha, "none"
    states = {r.get("status") for r in mine}
    if states & {"failure", "cancelled", "skipped", "blocked"}:
        return sha, "failure"
    if states == {"success"}:
        return sha, "success"
    return sha, "running"


# kept: the author disputes it; agreed: the author accepts it and hasn't fixed
# it yet. Both stay open, but only a dispute is the human's to decide.
STATUSES = ("new", "kept", "agreed", "fixed", "withdrawn")


def render(summary, findings, round_no, rounds, escalated=False, commit=None):
    lines = [summary.strip(), ""]
    if findings:
        lines.append(f"**Findings** (round {round_no} of {rounds}):")
        for i, f in enumerate(findings, 1):
            lines.append(f"{i}. **{f['section']}**: {f['finding'].strip()} *({f['status']})*")
    else:
        lines.append("No findings: this follows `CLAUDE.md` and the protocol.")
    record = {"round": round_no, "escalated": escalated,
              "findings": [{"section": f["section"], "status": f["status"]} for f in findings]}
    if commit:
        record["commit"] = commit
    lines += ["", f"<!-- conformance-findings: {json.dumps(record)} -->"]
    return "\n".join(lines)


def review(repo, n, path):
    """conformance's review of a pull request's head, with its rules in code:
    approve only when CI succeeded and no finding is open; after the rounds
    limit, hand the pull request to the human instead of reviewing again."""
    if ME != "conformance":
        die("only conformance reviews with forge review")
    try:
        with open(path) as f:
            spec = json.load(f)
        summary, findings = spec["summary"], spec.get("findings", [])
        for f in findings:
            if f.get("status") not in STATUSES or not f.get("section") or not f.get("finding"):
                raise ValueError(f"each finding needs a section, a finding and a status in {STATUSES}")
    except (OSError, ValueError, KeyError) as e:
        die(f"{path}: {e}")
    rounds = int(os.environ.get("CONFORMANCE_ROUNDS", "3"))
    sha, state = ci_state(repo, n)
    s, _ = api("GET", f"/repos/{ORG}/{repo}/contents/.forgejo/workflows?ref=main")
    if s == 200 and state != "success":  # a repository without CI (coordination) has nothing to wait for
        die(f"not reviewing {repo}#{n}: the Actions run for {sha[:12]} is {state}; you'll be woken when it succeeds")
    s, reviews = api("GET", f"/repos/{ORG}/{repo}/pulls/{n}/reviews")
    asked = sum(1 for r in reviews or [] if r["user"]["login"] == ME and r.get("state") == "REQUEST_CHANGES")
    open_findings = [f for f in findings if f["status"] in ("new", "kept", "agreed")]
    # Past the rounds limit only a dispute goes to the human: a finding the
    # author agreed with, or hasn't seen yet, is theirs to fix, so it gets an
    # ordinary request for changes. And a dispute goes once per head: with
    # nothing new pushed, there's nothing new to decide (demo#35).
    disputed = [f for f in findings if f["status"] == "kept"]
    if disputed and asked >= rounds:
        s, comments = api("GET", f"/repos/{ORG}/{repo}/issues/{n}/comments?limit=100")
        before = [json.loads(m.group(1)) for c in comments or [] if c["user"]["login"] == ME
                  for m in [re.search(r"<!-- conformance-findings: (\{.*?\}) -->", c.get("body") or "")] if m]
        if any(r.get("escalated") and r.get("commit") == sha for r in before):
            print(f"Already put to the human at {sha[:12]}; nothing new to review until the head changes.")
            return
        for f in disputed:
            f["status"] = "escalated"
        open_findings = disputed
        listed = "\n".join(f"- **{f['section']}**: {f['finding'].strip()}" for f in disputed)
        # The decision first, then the label: the dispatcher takes needs-human
        # off anything that doesn't state its decision.
        body = ("(no reply needed)\n\n" + render(summary, findings, asked + 1, rounds, escalated=True, commit=sha)
                + f"\n\nAfter {rounds} rounds these findings are still open, so you decide them.\n\n"
                + "## Question\n\nDo these findings stand? The author disputes each:\n\n" + listed
                + "\n\n## Options\n\n- Uphold them: say which, and the author fixes them.\n"
                + "- Overrule them: say so, and approve the pull request.\n"
                + "\n## Recommendation\n\nUphold them: each names the rule it breaks. Read the author's replies "
                + "on this pull request first.\n\n## If you say go ahead\n\nThe findings stand and the author "
                + "fixes them; I review again once they have.\n\n## Blocked on this\n\nThis pull request's merge.")
        s, p = api("POST", f"/repos/{ORG}/{repo}/issues/{n}/comments", {"body": body})
        if s // 100 != 2:
            die(f"couldn't escalate {repo}#{n} ({s}): {(p or {}).get('message', '')}")
        s, labels = api("GET", f"/repos/{ORG}/{repo}/labels?limit=100")
        ids = [l["id"] for l in labels or [] if l["name"] == "needs-human"]
        api("POST", f"/repos/{ORG}/{repo}/issues/{n}/labels", {"labels": ids})
        print(f"After {rounds} rounds, {repo}#{n} is labelled needs-human for the human to decide.")
        return
    event = "REQUEST_CHANGES" if open_findings else "APPROVED"
    s, p = api("POST", f"/repos/{ORG}/{repo}/pulls/{n}/reviews",
               {"event": event, "body": render(summary, findings, asked + 1, rounds), "commit_id": sha})
    if s // 100 != 2:
        die(f"couldn't review {repo}#{n} ({s}): {(p or {}).get('message', '')}")
    print(f"{'Requested changes on' if open_findings else 'Approved'} {repo}#{n} at {sha[:12]}.")


def release(repo, note, issues):
    if ME != "coordinator":
        die("only the coordinator asks the gatekeeper for releases")
    try:
        with open("/run/secrets/gatekeeper_key") as f:
            key = f.read().strip()
    except OSError:
        die("no gatekeeper key in this container")
    body = json.dumps({"repo": repo, "note": note, "issues": issues}).encode()
    req = urllib.request.Request("http://gatekeeper:8080/release", data=body, method="POST", headers={
        "Authorization": f"Bearer {key}", "Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=120) as r:
            p = json.loads(r.read())
    except urllib.error.HTTPError as e:
        try:
            msg = json.loads(e.read()).get("error", "")
        except ValueError:
            msg = ""
        die(f"the gatekeeper didn't release {repo}: {msg or e.code}")
    except urllib.error.URLError as e:
        die(f"can't reach the gatekeeper: {e.reason}")
    print(f"Released {repo} {p['version']} at {p['sha'][:12]}: {p['reason']}. {p.get('url', '')}")


def ledger(days):
    if ME != "process":
        die("only the process review reads the ledger")
    import time
    with open("/run/secrets/runner_key") as f:
        key = f.read().strip()
    url = f"{os.environ.get('DISPATCHER_URL', 'http://dispatcher:8080')}/ledger?since={time.time() - days * 86400:.0f}"
    req = urllib.request.Request(url, headers={"Authorization": f"Bearer {key}"})
    with urllib.request.urlopen(req, timeout=60) as r:
        sys.stdout.write(r.read().decode())


def main(argv):
    if len(argv) >= 3 and argv[0] == "pr" and argv[1] in ("automerge", "merge"):
        n = number(argv[2])
        merge = {"Do": "squash", "delete_branch_after_merge": True}
        # Forgejo acts on a scheduled merge only when a review or CI status
        # arrives after it, so one scheduled once everything passed would
        # never fire: merge directly when it can.
        s, p = merge_call(n, merge)
        if s // 100 == 2:
            print(f"#{n} merged.")
        elif argv[1] == "merge":
            die(f"#{n} didn't merge ({s}): {(p or {}).get('message', '')}")
        else:
            s, p = merge_call(n, {**merge, "merge_when_checks_succeed": True})
            if s // 100 != 2:
                die(f"couldn't schedule the merge of #{n} ({s}): {(p or {}).get('message', '')}")
            print(f"#{n} will merge once its checks succeed and it has the approvals it needs.")
    elif len(argv) >= 3 and argv[0] == "ci":
        repo, target = repo_name(argv[1]), argv[2] if argv[2] == "main" else number(argv[2])
        if argv[3:4] == ["--log"]:
            if argv[4:] not in ([], ["all"]):
                die("usage: forge ci <repo> <pr|main> --log [all]")
            ci_logs(repo, head_of(repo, target), argv[4:] == ["all"])
            return
        if argv[3:] == ["--rerun"]:
            ci_rerun(repo, target)
            return
        sha, state = ci_state(repo, target)
        print(f"{state} ({sha[:12]})")
        sys.exit(0 if state == "success" else 1)
    elif len(argv) == 4 and argv[0] == "review":
        review(repo_name(argv[1]), number(argv[2]), argv[3])
    elif len(argv) == 3 and argv[0] == "reviews":
        repo, n = repo_name(argv[1]), number(argv[2])
        s, reviews = api("GET", f"/repos/{ORG}/{repo}/pulls/{n}/reviews")
        if s != 200:
            die(f"can't read {repo}#{n}'s reviews ({s})")
        for r in reviews:
            print(f"--- {r['user']['login']}: {r.get('state')} at {(r.get('commit_id') or '')[:12]}, {r.get('submitted_at')}")
            print((r.get("body") or "").strip() + "\n")
    elif len(argv) >= 3 and argv[0] == "release":
        release(repo_name(argv[1]), argv[2], [number(n) for n in argv[3:]])
    elif len(argv) in (1, 2) and argv[0] == "ledger":
        ledger(int(argv[1]) if len(argv) == 2 and argv[1].isdigit() else 30)
    elif len(argv) >= 5 and argv[0] == "pr" and argv[1] == "approve":
        if ME != "coordinator":
            die("only the coordinator approves pull requests this way; conformance uses forge review")
        repo, n, msg = repo_name(argv[2]), number(argv[3]), " ".join(argv[4:])
        sha, state = ci_state(repo, n)
        if state != "success":
            die(f"not approving {repo}#{n}: the Actions run for {sha[:12]} is {state}")
        s, p = api("POST", f"/repos/{ORG}/{repo}/pulls/{n}/reviews",
                   {"event": "APPROVED", "body": msg, "commit_id": sha})
        if s // 100 != 2:
            die(f"couldn't approve {repo}#{n} ({s}): {(p or {}).get('message', '')}")
        print(f"Approved {repo}#{n} at {sha[:12]}.")
    else:
        usage()


if __name__ == "__main__":
    main(sys.argv[1:])
