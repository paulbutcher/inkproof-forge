#!/usr/bin/env python3
"""Claude Code hooks for agent containers (managed settings call these).

  inkproof-hook pre-tool        while paused, refuse every tool call in a run
  inkproof-hook session-start   a human session opened: record it
  inkproof-hook prompt          a human prompt: the human is busy
  inkproof-hook stop            Claude stopped: a human is idle from now;
                                a run may not stop with untriaged requests
  inkproof-hook session-end     a human session closed: record it; the human
                                is idle at once unless still here (see below)

A session is the human's when CLAUDE_CODE_ENTRYPOINT is claude-vscode or
cli and the runner didn't start it. The runner reads what these write in
/workspace/.inkproof: `activity` decides whether a run may start, and
`sessions.jsonl` goes into the dispatcher's ledger and the run archive.
"""
import json
import os
import sys
import time
import urllib.request

STATE = "/workspace/.inkproof"
GRACE = int(os.environ.get("HUMAN_GRACE_SECONDS", "600"))
# Ends that hand straight over to another session of the human's.
CONTINUING = ("clear", "resume")


def human():
    return (os.environ.get("CLAUDE_CODE_ENTRYPOINT") in ("claude-vscode", "cli")
            and not os.environ.get("INKPROOF_RUN"))


def write_activity(state, at=None):
    os.makedirs(STATE, exist_ok=True)
    tmp = f"{STATE}/activity.tmp"
    with open(tmp, "w") as f:
        json.dump({"state": state, "at": int(time.time()) if at is None else at}, f)
    os.replace(tmp, f"{STATE}/activity")


def other_session_live(ended):
    """Whether the human has another session open here that was in use
    within the grace period: started, not ended, and its transcript written
    lately. A session that crashed without an end stops counting once its
    transcript has been quiet that long, as its activity would have."""
    last = {}
    try:
        with open(f"{STATE}/sessions.jsonl") as f:
            for line in f:
                try:
                    e = json.loads(line)
                except ValueError:
                    continue
                last[e.get("session", "")] = e
    except OSError:
        return False
    for sid, e in last.items():
        if sid == ended or e.get("event") != "start":
            continue
        try:
            if time.time() - os.path.getmtime(e.get("transcript") or "") < GRACE:
                return True
        except OSError:
            continue
    return False


def record_session(event, data):
    os.makedirs(STATE, exist_ok=True)
    with open(f"{STATE}/sessions.jsonl", "a") as f:
        f.write(json.dumps({"event": event, "session": data.get("session_id", ""),
                            "transcript": data.get("transcript_path", ""),
                            "at": int(time.time())}) + "\n")


def untriaged_requests():
    """Open issues labelled request and new on the agent's own repository,
    by trusted authors. Never blocks on errors: an unreachable Forgejo must
    not trap the agent."""
    try:
        with open("/run/secrets/forgejo_token") as f:
            token = f.read().strip()
        org, repo = os.environ["FORGE_ORG"], os.environ["AGENT_REPO"]
        trusted = set(os.environ.get("TRUSTED_AUTHORS", "").split())
        req = urllib.request.Request(
            f"http://forgejo:3000/api/v1/repos/{org}/{repo}/issues"
            "?state=open&type=issues&labels=request,new&limit=50",
            headers={"Authorization": f"token {token}"})
        with urllib.request.urlopen(req, timeout=20) as r:
            issues = json.load(r)
    except Exception:
        return []
    return [i for i in issues
            if i.get("user", {}).get("login") in trusted
            and {"request", "new"} <= {l["name"] for l in i.get("labels") or []}]


def main():
    event = sys.argv[1] if len(sys.argv) > 1 else ""
    try:
        data = json.load(sys.stdin)
    except Exception:
        data = {}

    if event == "pre-tool":
        # While the human has paused the kit, a run does nothing more: every
        # tool call is refused and the run is told to stop. The human's own
        # sessions are not affected.
        if not human() and os.environ.get("INKPROOF_RUN") and os.path.exists("/etc/inkproof/control/paused"):
            print(json.dumps({
                "continue": False,
                "stopReason": "The kit is paused by the human.",
                "hookSpecificOutput": {
                    "hookEventName": "PreToolUse",
                    "permissionDecision": "deny",
                    "permissionDecisionReason": "The kit is paused by the human: stop now and do nothing more.",
                },
            }))
        return 0
    if event == "session-start":
        if human():
            record_session("start", data)
    elif event == "prompt":
        if human():
            write_activity("busy")
    elif event == "session-end":
        if human():
            # Closing the session means the human has gone: queued work may
            # start now rather than after the grace period, unless the session
            # was cleared or resumed into another, or another is still in use.
            gone = (data.get("reason") not in CONTINUING
                    and not other_session_live(data.get("session_id", "")))
            write_activity("idle", 0 if gone else None)
            record_session("end", data)
    elif event == "stop":
        if human():
            write_activity("idle")
            return 0
        if (data.get("stop_hook_active") or not os.environ.get("AGENT_REPO")
                or os.path.exists("/etc/inkproof/control/paused")):
            return 0
        pending = untriaged_requests()
        if pending:
            # Numbers only: issue text never goes into what steers a run.
            lines = "\n".join(f"  - #{i['number']}" for i in pending)
            print(f"Untriaged requests are waiting on {os.environ['AGENT_REPO']}:\n{lines}\n"
                  "Triage each one as your protocol describes before stopping.", file=sys.stderr)
            return 2
    return 0


if __name__ == "__main__":
    sys.exit(main())
