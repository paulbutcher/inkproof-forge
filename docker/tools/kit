#!/usr/bin/env bash
# Admin tasks against Forgejo, run in the tools container by the host scripts.
#   kit init-secrets   generate the runner and webhook secrets, if missing
#   kit check-human    succeed if secrets/human/token is a working admin token
#   kit bootstrap      converge accounts, tokens, teams and the webhook
#   kit migrate        import the repositories in agents.conf from GitHub
#   kit mirrors [--rotate]  push-mirror them to GitHub
#   kit mirror-status  each push mirror's last sync and error
#   kit setup-repo REPO LEVEL  apply an autonomy level to a repository
#   kit pause, kit resume  the human's brake (scripts/pause.sh, resume.sh)
#   kit project-status  requests, pull requests and needs-human items
#   kit reviews DAYS   which reviews have taken place, and their results
#   kit dispatcher METHOD PATH [JSON]  the dispatcher's admin requests
#   kit milestone NAME  open the milestone issue that starts the reviews
#   kit milestone-diff  every API.lock change since the last milestone
#   kit api METHOD PATH [JSON]  call the API as the human, print the reply
#   kit test-stage1    stage 1 checks against the API
#   kit test-stage2    stage 2 checks against the API
#   kit test-stage3 PHASE  stage 3 checks against the API (scripts/test-stage3.sh)
#   kit snapshot       what a backup must preserve, as JSON (scripts/backup.sh)
#   kit test-stage4..7 PHASE  later stages' checks (scripts/test-stageN.sh)
set -euo pipefail
. /usr/local/lib/kit/forge.sh
for f in /usr/local/lib/kit/*.sh; do [ "$f" = /usr/local/lib/kit/forge.sh ] || . "$f"; done

secret_file() {
  local f="/secrets/$1" bytes="$2"
  [ -s "$f" ] && return
  mkdir -p "$(dirname "$f")"
  ( umask 077; random_hex "$bytes" > "$f" )
  log "created secrets/$1"
}

cmd_init_secrets() {
  secret_file ci/runner-secret 20        # forgejo-cli wants 40 hex digits
  secret_file dispatcher/webhook-secret 32
  # Host scripts use it for the dispatcher's admin requests (drop work, reconcile).
  secret_file dispatcher/admin-key 32
  # Only the coordinator's container holds it: the gatekeeper releases only on
  # requests that carry it.
  secret_file gatekeeper/coordinator-key 32
  # Each agent's runner proves who it is to the dispatcher with its own key.
  local name
  for name in $(grep -v '^[[:space:]]*\(#\|$\)' /etc/kit/agents.conf | awk '{ print $1 }'); do
    secret_file "runner-keys/$name" 32
  done
}

# Exits 0 if the token works as HUMAN_USER with admin rights, 3 if Forgejo
# wants the account's password changed first, 1 otherwise.
cmd_check_human() {
  [ -s /secrets/human/token ] || exit 1
  TOKEN="$(token_of human)"
  local s
  s="$(api GET /user)"
  if [ "$s" = 403 ] && grep -q 'must change your password' "$RESP"; then exit 3; fi
  [ "$s" = 200 ] && [ "$(jq -r '.login + " " + (.is_admin | tostring)' "$RESP")" = "$HUMAN_USER true" ]
}

case "${1:-}" in
  init-secrets) cmd_init_secrets ;;
  check-human) cmd_check_human ;;
  bootstrap) cmd_bootstrap ;;
  migrate) cmd_migrate ;;
  mirrors) shift; cmd_mirrors "$@" ;;
  setup-repo) shift; cmd_setup_repo "$@" ;;
  pause) cmd_pause ;;
  resume) cmd_resume ;;
  project-status) cmd_project_status ;;
  reviews) shift; cmd_reviews "$@" ;;
  dispatcher) shift; cmd_dispatcher "$@" ;;
  milestone) shift; cmd_milestone "$@" ;;
  milestone-diff) cmd_milestone_diff ;;
  mirror-status) cmd_mirror_status ;;
  snapshot) cmd_snapshot ;;
  snapshot-compare) shift; cmd_snapshot_compare "$@" ;;
  api) shift; TOKEN="$(token_of human)"; call 200,201,204 "$@" | jq . ;;
  test-stage1) cmd_test_stage1 ;;
  test-stage2) shift; cmd_test_stage2 "$@" ;;
  test-stage3) shift; cmd_test_stage3 "$@" ;;
  test-stage4) shift; cmd_test_stage4 "$@" ;;
  test-stage5) shift; cmd_test_stage5 "$@" ;;
  test-stage6) shift; cmd_test_stage6 "$@" ;;
  test-stage7) shift; cmd_test_stage7 "$@" ;;
  *) sed -n '2,/^set /p' "$0" | sed '$d; s/^# \{0,1\}//' >&2; exit 2 ;;
esac
