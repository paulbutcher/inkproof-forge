# Writes compose.agents.yaml: docker/agent/compose.base.yaml, then one service
# and two volumes per agent in agents.conf (scripts/lib.sh runs it). POSIX awk,
# so the same on macOS and Linux.
#   awk -f scripts/compose-agents.awk agents.conf docker/agent/compose.base.yaml agents.conf
# The first pass over agents.conf collects the names for the base's AGENTS
# placeholders; the base is copied; the second pass writes the services.

FNR == 1 { file++ }
/^[[:space:]]*(#|$)/ && file != 2 { next }

file == 1 { names = names (names ? " " : "") $1; next }

file == 2 {
  if (FNR == 1) print "# Generated by scripts/lib.sh from agents.conf and docker/agent/compose.base.yaml: don't edit.\n"
  gsub(/\{\{AGENTS\}\}/, names)
  print
  next
}

{
  name = $1; kind = $2; own = $3
  reviewer = (own == "-")
  n++; agents[n] = name
  printf "\n  %s:\n    <<: *agent\n", name
  printf "    build:\n      <<: *agent-build\n      args:\n        <<: *agent-args\n"
  printf "        AGENT: %s\n        AGENT_REPO: \"%s\"\n", name, own
  printf "    image: inkproof-agent-%s:1\n    hostname: %s\n", name, name
  if (kind == "coordinator") {
    print "    # It alone shares a network with the gatekeeper, which it asks for releases."
    print "    networks: [agents, gate-coord]"
  }
  printf "    environment:\n      <<: *agent-env\n      AGENT_NAME: %s\n", name
  printf "      AGENT_REPO: \"%s\"\n", reviewer ? "" : own
  if (reviewer) printf "      AGENT_WORKSPACE: /workspace/%s\n", name
  if (kind == "pr-reviewer") print "      CONFORMANCE_ROUNDS: ${CONFORMANCE_ROUNDS:-3}"
  printf "      GIT_AUTHOR_NAME: %s\n      GIT_AUTHOR_EMAIL: %s@noreply.localhost\n", name, name
  printf "      GIT_COMMITTER_NAME: %s\n      GIT_COMMITTER_EMAIL: %s@noreply.localhost\n", name, name
  print "    volumes:"
  printf "      - ${STATE_DIR:-.}/secrets/%s/token:/run/secrets/forgejo_token:ro\n", name
  printf "      - ${STATE_DIR:-.}/secrets/runner-keys/%s:/run/secrets/runner_key:ro\n", name
  if (kind == "coordinator") print "      - ${STATE_DIR:-.}/secrets/gatekeeper/coordinator-key:/run/secrets/gatekeeper_key:ro"
  print "      - ${STATE_DIR:-.}/control:/etc/inkproof/control:ro"
  printf "      - work-%s:/workspace\n      - claude-%s:/home/agent/.claude\n", name, name
  print "      - agent-elan:/home/agent/.elan"
  printf "      - type: volume\n        source: run-archive\n        target: /var/lib/inkproof/archive\n"
  printf "        volume: { subpath: %s }\n", name
  if (name == "process") {
    print "      # Every agent's runs and the human's sessions, for the process review."
    print "      - type: volume\n        source: run-archive\n        target: /var/lib/inkproof/archive-all\n        read_only: true"
  }
}

END {
  print "\nvolumes:"
  for (i = 1; i <= n; i++) printf "  work-%s:\n  claude-%s:\n", agents[i], agents[i]
}
