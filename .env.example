# Copy to .env and edit.

# The GitHub account the repositories live under, which Forgejo imports from
# and mirrors to.
GH_OWNER=paulbutcher

# GitHub owners the repositories used to live under, space-separated. Old tags'
# lakefiles still name them; GitHub redirects them, and CI and agents fetch
# them from Forgejo just as they do GH_OWNER's.
GH_FORMER_OWNERS=tentenths

# The Forgejo organisation that holds the repositories. It can't be
# HUMAN_USER: Forgejo users and organisations share one namespace.
FORGE_ORG=tentenths

# Every repository in this project starts with this prefix.
REPO_PREFIX=inkproof-

# Your Forgejo username (the same as on GitHub, so CODEOWNERS entries match)
# and the email for your Forgejo account.
HUMAN_USER=paulbutcher
HUMAN_EMAIL=you@example.com

# Must match the host user that owns secrets/ (id -u ; id -g).
HOST_UID=501
HOST_GID=20

# Host port for Forgejo's web UI and API, bound to 127.0.0.1 only.
FORGE_PORT=3000

# Where this environment keeps secrets/, control/ and backups/. Must start
# with ./ or /. The default suits your Mac. The kit's dev container mounts the
# same checkout and uses .env.devcontainer instead, with its own STATE_DIR
# (for example ./.devcontainer-state) and its own FORGE_PORT (for example
# 3300), so the two never share credentials or compete for a port.
STATE_DIR=./

# Branches pushed to the GitHub mirrors, as a Forgejo branch filter (for
# example "main" or "main,release/*"); empty mirrors every branch. Tags are
# always mirrored. Forgejo mirrors exactly, so branches outside the filter are
# deleted on GitHub at the first sync.
MIRROR_BRANCHES=main

# Host port for the dispatcher's status, bound to 127.0.0.1 only.
DISPATCHER_PORT=3001

# Agents: how long after your last activity in an agent's container its runs
# may start (seconds), how long a run may last (minutes), and how many runs
# each agent may start per UTC day.
# HUMAN_GRACE_SECONDS=600
# MAX_RUN_MINUTES=240
# MAX_RUNS_PER_DAY=20
# The coordinator's own cap: every other agent's work wakes it.
# MAX_COORDINATOR_RUNS_PER_DAY=40
# How long the coordinator's "pull request opened" waits, so that a review
# requested from it in that time shares the run (seconds).
# PR_OPENED_HOLD_SECONDS=600
# A daily spending cap per agent, in dollars (0: none), and how often the
# dispatcher looks in Forgejo for work a missed webhook would have lost.
# MAX_SPEND_PER_DAY=0
# RECONCILE_SECONDS=900
# How long the kit must be quiet (no run, no queued work, no CI) before the
# coordinator tells you what it needs from you, in a session the Claude
# extension lists in its container (seconds; 0: never).
# IDLE_SECONDS=1200
# A released request nobody has verified: its requester is woken again after
# the first, and after the second it's a decision for you (seconds).
# UNVERIFIED_NUDGE_SECONDS=86400
# UNVERIFIED_STALL_SECONDS=172800

# Reviews: the longest a pull request's head waits, after CI passes, before
# conformance reviews it (seconds; an agent's pull request is reviewed as soon
# as its run has ended), and how many rounds of findings it gives
# before handing a pull request to you as needs-human.
# CONFORMANCE_SETTLE_SECONDS=600
# CONFORMANCE_ROUNDS=3

# Level 2: how often the gatekeeper looks for pull requests whose CI has
# passed (seconds).
# GATEKEEPER_POLL_SECONDS=30

# Backups (scripts/backup.sh): where they go, and how many to keep. Time
# Machine keeps older ones if it covers this folder. scripts/restore-test.sh
# shows its restored copy on this port while KEEP=1 holds it.
# BACKUP_DIR=./backups
# BACKUP_KEEP=7
# RESTORE_TEST_PORT=3002
